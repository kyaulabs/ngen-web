{
  "schemaVersion": 1,
  "baseUrl": "http://127.0.0.1:4173",
  "viewports": {
    "mobile": { "width": 390, "height": 844 },
    "desktop": { "width": 1920, "height": 1080 }
  },
  "cases": [
    {
      "id": "dashboard",
      "path": "/",
      "readySelector": "body.loaded",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [] },
        { "id": "primary-hover-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".hero-cta .btn-primary" }] },
        { "id": "control-hover-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#motion-toggle" }] },
        { "id": "control-focus-dark", "colorScheme": "dark", "actions": [{ "type": "focus", "selector": "#motion-toggle" }] },
        { "id": "offline-dark", "colorScheme": "dark", "actions": [] },
        { "id": "tracker-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": "#issues-list .term-open" }] },
        { "id": "contributor-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": ".contrib-card" }] },
        { "id": "scrolled-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#activity .sec-head" }] },
        { "id": "footer-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".footer" }] },
        { "id": "scrolled-controls-hover-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#activity .sec-head" }, { "type": "hover", "selector": "#motion-toggle" }] },
        { "id": "tracker-close-hover-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": "#issues-list .term-open" }, { "type": "hover", "selector": ".term-dot-close" }] },
        { "id": "tracker-closed-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": "#issues-tabs [data-state=closed]" }, { "type": "click", "selector": "#prs-tabs [data-state=closed]" }] },
        { "id": "release-collapsed-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": ".release-toggle" }, { "type": "wait-for-selector", "selector": ".release-card:not(.expanded)" }] }
      ]
    },
    {
      "id": "section-headings",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#vitals .sec-head",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#vitals .sec-head" }] }
      ]
    },
    {
      "id": "release-changelog",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#release-changelog-modal .pkg-modal",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": ".release-changelog" }] },
        { "id": "close-hover-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": ".release-changelog" }, { "type": "hover", "selector": "#release-changelog-modal .term-dot-close" }] }
      ]
    },
    {
      "id": "release-code",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#releases .md-body > h2 + .release-code",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#releases .md-body > h2 + .release-code pre" }] },
        { "id": "copied-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": "#releases .md-body > h2 + .release-code .clone-copy" }, { "type": "wait-for-selector", "selector": "#releases .md-body > h2 + .release-code use[href$=\"#check\"]" }] }
      ]
    },
    {
      "id": "roadmap",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#milestones .roadmap-content",
      "states": [
        { "id": "kanban-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": "#kanban-tab" }, { "type": "scroll-into-view", "selector": "#milestones .roadmap-content" }] },
        { "id": "roadmap-unavailable-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".roadmap-controls" }] },
        { "id": "roadmap-empty-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".roadmap-controls" }] }
      ]
    },
    {
      "id": "roadmap-stems",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#milestones-view",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "wait-for-selector", "selector": ".milestone-item-list" }, { "type": "scroll-into-view", "selector": "#milestones-view" }] },
        { "id": "objectives-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": ".milestone-next" }, { "type": "wait-for-selector", "selector": ".milestone-card[data-milestone='1'] .milestone-item-list" }, { "type": "scroll-into-view", "selector": "#milestones-view" }] }
      ]
    },
    {
      "id": "branches",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#branches-list",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "scroll-into-view", "selector": "#branches-list" }, { "type": "hover", "selector": "#branches-list" }] },
        { "id": "offline-dark", "colorScheme": "dark", "actions": [{ "type": "scroll-into-view", "selector": "#branches-list" }, { "type": "hover", "selector": "#branches-list" }] },
        { "id": "checks-failed-dark", "colorScheme": "dark", "actions": [{ "type": "scroll-into-view", "selector": "#branches-list" }, { "type": "hover", "selector": "#branches-list" }] },
        { "id": "checks-empty-dark", "colorScheme": "dark", "actions": [{ "type": "scroll-into-view", "selector": "#branches-list" }, { "type": "hover", "selector": "#branches-list" }] },
        { "id": "checks-unavailable-dark", "colorScheme": "dark", "actions": [{ "type": "scroll-into-view", "selector": "#branches-list" }, { "type": "hover", "selector": "#branches-list" }] },
        { "id": "checks-focus-dark", "colorScheme": "dark", "actions": [{ "type": "focus", "selector": ".branch-card:first-child .branch-checks" }] }
      ]
    },
    {
      "id": "games",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#install",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#install .pkg-head" }] }
      ]
    },
    {
      "id": "activity",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#activity > .panel-chart",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#activity .sec-head" }] }
      ]
    },
    {
      "id": "matrix",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#matrix",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#matrix .sec-head" }] }
      ]
    },
    {
      "id": "footer-links",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": ".footer-grid",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".footer-mark" }] },
        { "id": "link-hover-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".footer-meta p:first-child a" }] }
      ]
    },
    {
      "id": "ticker-links",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": ".ticker",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".ticker-label" }] }
      ]
    },
    {
      "id": "contributor-links",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": ".contrib-commits",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": ".contrib-card" }, { "type": "wait-for-selector", "selector": ".contrib-commit" }, { "type": "hover", "selector": ".contrib-modal .pkg-modal-h:nth-of-type(2)" }] },
        { "id": "commit-hover-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": ".contrib-card" }, { "type": "wait-for-selector", "selector": ".contrib-commit" }, { "type": "hover", "selector": ".contrib-commit" }] }
      ]
    },
    {
      "id": "contributors",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#contributors",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": "#contributors .sec-head" }] }
      ]
    },
    {
      "id": "footer-notice",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": ".footer-legal",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".footer-legal" }] }
      ]
    },
    {
      "id": "releases",
      "path": "/",
      "readySelector": "body.loaded",
      "captureSelector": "#releases .release-card",
      "states": [
        { "id": "dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".release-title" }] },
        { "id": "changelog-hover-dark", "colorScheme": "dark", "actions": [{ "type": "hover", "selector": ".release-changelog" }] },
        { "id": "collapsed-dark", "colorScheme": "dark", "actions": [{ "type": "click", "selector": ".release-toggle" }, { "type": "wait-for-selector", "selector": ".release-card:not(.expanded)" }] }
      ]
    }
  ]
}
